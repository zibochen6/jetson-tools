{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jetson Remote",
  "version": "0.3.12",
  "identifier": "com.jetsonremote.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jetson Remote",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "A6FE35E235469A83B38C5849ACE422E1024DD538",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64",
          "libcairo2",
          "libfreerdp3-3",
          "libfreerdp-client3-3",
          "libwinpr3-3",
          "libxdo3",
          "openssh-client",
          "curl",
          "xdg-utils",
          "ca-certificates"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
